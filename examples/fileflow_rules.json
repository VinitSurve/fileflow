{
  "version": 1,
  "rules": [
    {
      "id": "invoices-pdf",
      "name": "PDF Invoices & Receipts",
      "enabled": true,
      "priority": 10,
      "destination": "Documents/Finance/{year}",
      "extensions": [".pdf"],
      "name_glob": "*invoice*",
      "name_regex": null,
      "min_size": null,
      "max_size": null,
      "modified_before": null,
      "modified_after": null,
      "created_before": null,
      "created_after": null,
      "category": null,
      "source_folder": null
    },
    {
      "id": "screenshots-png",
      "name": "macOS Screenshots",
      "enabled": true,
      "priority": 20,
      "destination": "Images/Screenshots/{year}-{month}",
      "extensions": [".png", ".jpg"],
      "name_glob": null,
      "name_regex": "^(Screen Shot|Screenshot)[ _-].*",
      "min_size": null,
      "max_size": null,
      "modified_before": null,
      "modified_after": null,
      "created_before": null,
      "created_after": null,
      "category": "Images",
      "source_folder": null
    },
    {
      "id": "large-installers",
      "name": "Large macOS Disk Images & Installers",
      "enabled": true,
      "priority": 30,
      "destination": "Archives/Installers",
      "extensions": [".dmg", ".pkg", ".iso"],
      "name_glob": null,
      "name_regex": null,
      "min_size": 10000000,
      "max_size": null,
      "modified_before": null,
      "modified_after": null,
      "created_before": null,
      "created_after": null,
      "category": null,
      "source_folder": null
    },
    {
      "id": "archived-logs",
      "name": "Old Log Files",
      "enabled": true,
      "priority": 50,
      "destination": "Documents/Logs/Archive",
      "extensions": [".log", ".txt"],
      "name_glob": "*.log",
      "name_regex": null,
      "min_size": null,
      "max_size": null,
      "modified_before": "30d",
      "modified_after": null,
      "created_before": null,
      "created_after": null,
      "category": null,
      "source_folder": null
    }
  ]
}
